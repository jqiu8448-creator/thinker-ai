{
  "name": "taro-app",
  "version": "1.0.0",
  "private": true,
  "description": "思想家AI 跨端（微信小程序 + H5）",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "build:data": "node ../../scripts/build-thinkers.js",
    "preview": "npx --yes serve dist",
    "server:start": "node server/index.js",
    "server:dev": "node --watch server/index.js"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@tarojs/components": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@tarojs/cli": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-loader": "^9.1.3",
    "babel-preset-taro": "4.2.0",
    "sass": "^1.77.0",
    "vite": "^5.4.0"
  },
  "overrides": {
    "ajv-keywords": "5.1.0"
  }
}
