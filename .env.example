# ============ LLM API 配置（必填） ============
# 兼容 OpenAI 格式的接口地址（含 /v1）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=gpt-4o-mini

# ============ 托管模式配额 ============
# 每人每天可提问次数（按 IP + 浏览器指纹 双绑）
DAILY_LIMIT=3

# ============ 飞书机器人（可选） ============
# 不接入飞书可留空
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ============ 服务配置 ============
PORT=3000
# 时区：影响"每日"配额的重置时刻，国内用户建议 Asia/Shanghai
TZ=Asia/Shanghai
